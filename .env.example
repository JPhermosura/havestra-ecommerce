# Database Configuration
MONGODB_URI=mongodb://localhost:27017/havestra

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server Configuration
PORT=3002
NODE_ENV=development

# Seed Configuration
# Set to true ONLY if you want to populate demo users/products.
# This will create default demo accounts:
# - admin@example.com / admin123
# - seller@example.com / seller123
# - buyer@example.com / buyer123
SEED_DATA=false

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880

# Private identity-document storage (outside client/public and dist/public)
# Optional absolute path outside the entire project/Vite workspace:
# ID_DOCUMENTS_DIR=/absolute/private/path/havestra-id-documents

# Optional Sumsub Identity verification. Leave all unset for pending-review fallback.
# Configure app token permissions, verification level, and signed webhook first.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_WEBHOOK_SECRET=

# Email Configuration (optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Payment Configuration (optional)
PAYMENT_GATEWAY_API_KEY=your-payment-api-key
PAYMENT_GATEWAY_SECRET=your-payment-secret